{
    "name": "all1web/nativephp-wifi-scan",
    "description": "WiFi Radar for NativePHP Mobile — scan the visible WiFi access points (SSID/BSSID/RSSI), read the connected AP, and turn what's visible into a stable place fingerprint, straight from Laravel.",
    "type": "nativephp-plugin",
    "keywords": [
        "nativephp",
        "nativephp-mobile",
        "android",
        "wifi",
        "wifi-scan",
        "bssid",
        "rssi",
        "indoor-location",
        "fingerprint",
        "laravel"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "ALL 1",
            "email": "neo@all1web.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0",
        "nativephp/mobile": "^3.0 || ^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^2.7|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "WifiScan\\Mobile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WifiScan\\Mobile\\Tests\\": "tests/"
        },
        "files": [
            "tests/stubs.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WifiScan\\Mobile\\WifiScanServiceProvider"
            ],
            "aliases": {
                "Wifi": "WifiScan\\Mobile\\Facades\\Wifi"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "support": {
        "email": "plugins@all1.ai",
        "issues": "https://github.com/all1web/nativephp-wifi-scan/issues"
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
